# ==============================
# SEGURIDAD - JWT
# ==============================
# Debe tener mínimo 32 caracteres. Genera uno nuevo y aleatorio antes
# de subir a servidor real (no reutilices el de desarrollo).
JWT_SECRET=

# ==============================
# USUARIO ADMINISTRADOR INICIAL (DataInitializer)
# ==============================
# Correo y contraseña del primer usuario MAIN creado al arrancar el
# sistema por primera vez (solo se usa si la tabla rol está vacía).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ==============================
# BASE DE DATOS (Neon PostgreSQL)
# ==============================
# Copia estos valores desde tu conexión actual de Neon antes de
# continuar - no los inventes.
DB_URL=
DB_USERNAME=
DB_PASSWORD=
